{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wavecheck",
  "version": "0.1.0",
  "identifier": "com.wavecheck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "wavecheck",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 wavecheck",
    "publisher": "wavecheck",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": [
      "licenses/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5OEUzRjZCMjY5NjQ1MTcKUldRWFJaWW1heitPR1Qzcms2VXc1RE4zaVdHMnJJS2JhTHdxdG9LY1hwZE9GdC8rempzL3p4cXUK",
      "endpoints": [
        "https://github.com/smallworldbigouthere/wavecheck/releases/latest/download/latest.json"
      ]
    }
  }
}
